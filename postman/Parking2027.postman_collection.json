{
  "info": {
    "name": "Parking2027 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "placa",
      "value": "ABC123"
    },
    {
      "key": "idRegistro",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Preparacion",
      "item": [
        {
          "name": "Tarifas vigentes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tarifas?vigentes=true"
          }
        },
        {
          "name": "Crear lote carros 1-10",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/espacios/lote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desde\": 1,\n  \"hasta\": 10,\n  \"tipo\": \"CARRO\"\n}"
            }
          }
        },
        {
          "name": "Crear lote motos 11-15",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/espacios/lote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desde\": 11,\n  \"hasta\": 15,\n  \"tipo\": \"MOTO\"\n}"
            }
          }
        },
        {
          "name": "Crear lote bicicletas 16-20",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/espacios/lote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desde\": 16,\n  \"hasta\": 20,\n  \"tipo\": \"BICICLETA\"\n}"
            }
          }
        },
        {
          "name": "Listar espacios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/espacios"
          }
        }
      ]
    },
    {
      "name": "2. Flujo por placa",
      "item": [
        {
          "name": "Entrada carro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"tipo\": \"CARRO\",\n  \"descripcion\": \"Mazda rojo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('idRegistro', j.idRegistro);"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrada duplicada (espera 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"tipo\": \"CARRO\"\n}"
            }
          }
        },
        {
          "name": "Ver registro activo por placa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/{{placa}}"
          }
        },
        {
          "name": "Ver cobro por placa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/{{placa}}/cobro"
          }
        },
        {
          "name": "Registrar salida por placa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/{{placa}}/salida"
          }
        },
        {
          "name": "Salida repetida por placa (espera 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/{{placa}}/salida"
          }
        },
        {
          "name": "Historial por placa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/vehiculos/{{placa}}/registros"
          }
        },
        {
          "name": "Salida de placa inexistente (espera 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/NOEXI99/salida"
          }
        },
        {
          "name": "Placa invalida (espera 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/placa/@@/salida"
          }
        }
      ]
    },
    {
      "name": "3. Flujo por id",
      "item": [
        {
          "name": "Entrada carro 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"DEF456\",\n  \"tipo\": \"CARRO\",\n  \"numeroEspacio\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('idRegistro', j.idRegistro);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver cobro por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/{{idRegistro}}/cobro"
          }
        },
        {
          "name": "Registrar salida por id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/{{idRegistro}}/salida"
          }
        },
        {
          "name": "Salida repetida por id (espera 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/{{idRegistro}}/salida"
          }
        },
        {
          "name": "Obtener registro por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/registros/{{idRegistro}}"
          }
        }
      ]
    },
